#!/bin/bash
echo "Running Push sources GHA test with act..."
act -j test -s LOKALISE_API_TOKEN=123456789

echo "🧪 Testing Manual Translations GitHub Action..."
echo "================================================"

# Stash any uncommitted changes to preserve them
echo "Stashing any uncommitted changes..."
git stash push -m "Pre-test stash: $(date)" || echo "No changes to stash"

# Store current branch name and commit
CURRENT_BRANCH=$(git branch --show-current)
ORIGINAL_COMMIT=$(git rev-parse HEAD)
echo "Current branch: $CURRENT_BRANCH"
echo "Original commit: $ORIGINAL_COMMIT"

# Create and switch to temporary test branch
echo "Creating temporary test branch..."
git checkout -b temp-test-branch

echo ""
echo "🟢 Test 1: Success Case (non-es_US file modified)"
echo "Expected: Workflow should PASS"
echo "----------------------------------------------"
echo "# Test modification $(date)" >> test/config/locales/en/en.yml
echo "Committing test modification to en file..."
git add test/config/locales/en/en.yml && git commit -m "Test: modify en file"
act -j test-manual-translations-check -e .github/workflows/test-event-no-label.json

echo ""
echo "🟡 Test 2: Skip Case (lokalise-translation label present)"
echo "Expected: Workflow should SKIP validation and SUCCEED"
echo "----------------------------------------------"
act -j test-manual-translations-check -e .github/workflows/test-event-lokalise-label.json

echo ""
echo "🔴 Test3: Failure Case (es_US file modified)"
echo "Expected: Workflow should FAIL"
echo "----------------------------------------------"
echo "# Test modification $(date)" >> test/config/locales/es_US/test.yml
echo "Committing test modification to es_US file..."
git add test/config/locales/es_US/test.yml && git commit -m "Test: modify es_US file"
act -j test-manual-translations-check -e .github/workflows/test-event-no-label.json

# Clean up: return to original branch and delete temp branch
echo ""
echo "🧹 Cleaning up..."
echo "Returning to original branch: $CURRENT_BRANCH"
git checkout $CURRENT_BRANCH

echo "Resetting to original commit: $ORIGINAL_COMMIT"
git reset --hard $ORIGINAL_COMMIT

echo "Deleting temporary test branch..."
git branch -D temp-test-branch

# Restore any pre-test stashed changes
echo "Restoring pre-test stashed changes..."
if git stash list | grep -q "Pre-test stash"; then
    git stash pop
    echo "Pre-test changes restored"
else
    echo "No pre-test changes to restore"
fi

echo "✅ All tests completed! Your working directory is restored to its original state."
