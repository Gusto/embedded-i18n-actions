#!/bin/bash
set -e

echo "╔════════════════════════════════════════════════════════════════════╗"
echo "║              Embedded I18n Actions - Test Suite                   ║"
echo "╚════════════════════════════════════════════════════════════════════╝"
echo ""

TOTAL_PASSED=0
TOTAL_FAILED=0

# ============================================================================
# PART 1: Unit Tests for Manual Translations Check Regex Fix
# ============================================================================
echo "════════════════════════════════════════════════════════════════════"
echo "📝 PART 1: Unit Tests (Regex Pattern Validation)"
echo "════════════════════════════════════════════════════════════════════"
echo ""

# Test the multiple file patterns fix
file_patterns="config/locales/es_US/**
test/config/locales/es_US/**"

echo "Test Configuration:"
echo "  File patterns to protect:"
echo "    - config/locales/es_US/**"
echo "    - test/config/locales/es_US/**"
echo ""

# Generate regex patterns using the fixed method
regex_patterns=$(echo "$file_patterns" | grep -v '^$' | sed 's|\*|.*|g' | sed 's|^|.*|' | paste -sd '|' -)
echo "Generated regex: $regex_patterns"
echo ""

run_unit_test() {
    local test_name=$1
    local changed_files=$2
    local should_match=$3
    
    if echo "$changed_files" | grep -qE "$regex_patterns"; then
        result="MATCH"
    else
        result="NO MATCH"
    fi
    
    if [ "$result" = "$should_match" ]; then
        echo "  ✅ PASSED: $test_name"
        ((TOTAL_PASSED++))
        return 0
    else
        echo "  ❌ FAILED: $test_name (got: $result, expected: $should_match)"
        ((TOTAL_FAILED++))
        return 1
    fi
}

run_unit_test "Non-protected file" "config/locales/en/en.yml" "NO MATCH"
run_unit_test "First pattern (config/locales/es_US)" "config/locales/es_US/test.yml" "MATCH"
run_unit_test "Second pattern (test/config/locales/es_US) ⭐" "test/config/locales/es_US/file.yml" "MATCH"
run_unit_test "Deeply nested path" "app/deep/config/locales/es_US/file.yml" "MATCH"

echo ""

# ============================================================================
# PART 2: Push Sources Action Test (with act)
# ============================================================================
echo "════════════════════════════════════════════════════════════════════"
echo "📦 PART 2: Push Sources Action Test"
echo "════════════════════════════════════════════════════════════════════"
echo ""

if command -v act &> /dev/null; then
    echo "Running Push sources GHA test with act..."
    if act -j test -s LOKALISE_API_TOKEN=123456789 2>&1 | head -50; then
        echo "✅ Push sources test completed"
        ((TOTAL_PASSED++))
    else
        echo "⚠️  Push sources test had issues (this is optional)"
    fi
else
    echo "⚠️  'act' not found, skipping integration tests"
    echo "   Install with: brew install act"
fi

echo ""

# ============================================================================
# PART 3: Manual Translations Check Integration Test (with act)
# ============================================================================
echo "════════════════════════════════════════════════════════════════════"
echo "🔄 PART 3: Manual Translations Check Integration Test"
echo "════════════════════════════════════════════════════════════════════"
echo ""

if ! command -v act &> /dev/null; then
    echo "⚠️  Skipping integration tests (act not installed)"
    echo ""
else
    # Stash any uncommitted changes to preserve them
    echo "Stashing any uncommitted changes..."
    git stash push -m "Pre-test stash: $(date)" || echo "No changes to stash"

    # Store current branch name and commit
    CURRENT_BRANCH=$(git branch --show-current)
    ORIGINAL_COMMIT=$(git rev-parse HEAD)
    
    # Create temporary test branch
    TEST_BRANCH="temp-test-branch-$(date +%s)"
    echo "Creating temporary test branch: $TEST_BRANCH"
    git checkout -b "$TEST_BRANCH"

    echo ""
    echo "Test 1: Non-protected file modification"
    echo "  Modifying: test/config/locales/en/en.yml"
    echo "  Expected: Workflow should PASS"
    echo "# Test modification $(date)" >> test/config/locales/en/en.yml
    git add test/config/locales/en/en.yml
    git -c commit.gpgsign=false commit -m "Test: modify en file" || true
    
    echo ""
    echo "Test 2: Protected file modification (validates the fix!)"
    echo "  Modifying: test/config/locales/es_US/test.yml (2nd pattern)"
    echo "  Expected: Workflow should FAIL and detect the change"
    echo "# Test modification $(date)" >> test/config/locales/es_US/test.yml
    git add test/config/locales/es_US/test.yml
    git -c commit.gpgsign=false commit -m "Test: modify es_US file" || true

    echo ""
    echo "Note: Full integration testing with act requires GitHub credentials"
    echo "      For complete validation, test in a real GitHub Actions environment"
    
    # Clean up
    echo ""
    echo "🧹 Cleaning up test branch..."
    git checkout "$CURRENT_BRANCH"
    git reset --hard "$ORIGINAL_COMMIT"
    git branch -D "$TEST_BRANCH" 2>/dev/null || true
    
    # Restore stashed changes
    if git stash list | grep -q "Pre-test stash"; then
        git stash pop
    fi
fi

# ============================================================================
# Final Summary
# ============================================================================
echo ""
echo "════════════════════════════════════════════════════════════════════"
echo "📊 TEST SUMMARY"
echo "════════════════════════════════════════════════════════════════════"
echo ""
echo "  Unit Tests Passed: $TOTAL_PASSED"
echo "  Unit Tests Failed: $TOTAL_FAILED"
echo ""

if [ $TOTAL_FAILED -eq 0 ]; then
    echo "✅ All core unit tests PASSED!"
    exit 0
else
    echo "❌ Some tests FAILED. Please review the test output above for details."
    exit 1
fi
